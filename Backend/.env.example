NODE_ENV=development
PORT=8080

# Local MongoDB or a MongoDB Atlas connection string.
# The database name is set separately by DB_NAME, so the URI does not need it.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=keylessflow

# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*
# Set to true when running behind a proxy/load balancer (Render, Railway, Nginx)
TRUST_PROXY=false
# Used to build links in notifications (resume booking, check-in, etc.)
FRONTEND_URL=http://localhost:3000

# Auth: use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Paystack (test keys from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback
PAYSTACK_BASE_URL=https://api.paystack.co

# Booking rules
CURRENCY=NGN
BOOKING_HOLD_MINUTES=30
BOOKING_MAX_NIGHTS=30
ABANDONMENT_NUDGE_AFTER_MINUTES=15

# Check-in and room access rules
CHECKIN_WINDOW_HOURS=48
MAX_VERIFICATION_ATTEMPTS=3
# Room keys stop working at this hour (UTC) on the check-out date. 11 UTC = 12 noon in Lagos
CHECKOUT_HOUR_UTC=11

# How often background jobs (expire holds, send reminders) run
JOB_INTERVAL_MINUTES=5

# Seed accounts (npm run seed). Required in production; dev defaults are used otherwise
SEED_ADMIN_EMAIL=admin@keylessflow.test
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=staff@keylessflow.test
SEED_STAFF_PASSWORD=
